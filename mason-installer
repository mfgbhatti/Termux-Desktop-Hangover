
#!/data/data/com.termux/files/usr/bin/bash

# Install a package using Termux pkg or pacman and register its
# executable as a Mason-compatible package for Neovim.
#
# Usage:
#   ./mason-termux.sh <package-name> [executable-name]
#
# Examples:
#   ./mason-termux.sh shfmt
#   ./mason-termux.sh shellcheck
#   ./mason-termux.sh stylua
#   ./mason-termux.sh ruff
#
# If package name and executable name differ:
#   ./mason-termux.sh lua-language-server lua-language-server

set -u

MASON_DIR="${HOME}/.local/share/nvim/mason/packages"

die() {
  echo "Error: $*" >&2
  exit 1
}

install_package() {
  local package_name="$1"

  if command -v pkg >/dev/null 2>&1; then
    echo "Package manager: pkg"
    echo "Installing: $package_name"

    pkg install -y "$package_name"

  elif command -v pacman >/dev/null 2>&1; then
    echo "Package manager: pacman"
    echo "Installing: $package_name"

    pacman -S --needed --noconfirm "$package_name"

  else
    die "Neither pkg nor pacman was found."
  fi
}

find_executable() {
  local executable_name="$1"
  local path

  path="$(command -v "$executable_name" 2>/dev/null)" || return 1

  [ -x "$path" ] || return 1

  printf '%s\n' "$path"
}

setup_package_for_mason() {
  local package_name="${1:-}"
  local executable_name="${2:-}"
  local package_dir
  local libexec_dir
  local wrapper_script
  local binary_path

  if [ -z "$package_name" ]; then
    echo "Usage:"
    echo "  $(basename "$0") <package-name> [executable-name]"
    echo
    echo "Examples:"
    echo "  $(basename "$0") shfmt"
    echo "  $(basename "$0") shellcheck"
    echo "  $(basename "$0") stylua"
    echo "  $(basename "$0") ruff"
    exit 1
  fi

  # If executable name wasn't supplied, assume it is the same
  # as the package name.
  if [ -z "$executable_name" ]; then
    executable_name="$package_name"
  fi

  echo
  echo "========================================"
  echo " Mason / Termux package setup"
  echo "========================================"
  echo "Package    : $package_name"
  echo "Executable : $executable_name"
  echo

  # ----------------------------------------
  # 1. Install package
  # ----------------------------------------

  if ! install_package "$package_name"; then
    die "Failed to install $package_name."
  fi

  echo
  echo "Package installed."

  # ----------------------------------------
  # 2. Locate executable
  # ----------------------------------------

  echo "Looking for executable: $executable_name"

  binary_path="$(find_executable "$executable_name")" || {
    echo
    echo "Could not find executable: $executable_name"
    echo
    echo "Installed commands containing the package name:"
    command -v "$package_name" 2>/dev/null || true
    echo
    echo "If the executable has a different name, run:"
    echo "  $(basename "$0") $package_name <executable-name>"
    exit 1
  }

  echo "Binary found: $binary_path"

  # ----------------------------------------
  # 3. Mason directories
  # ----------------------------------------

  package_dir="$MASON_DIR/$package_name"
  libexec_dir="$package_dir/libexec"

  echo
  echo "Creating Mason directories:"
  echo "$libexec_dir"

  mkdir -p "$libexec_dir" || {
    die "Failed to create Mason directories."
  }

  # ----------------------------------------
  # 4. Link executable
  # ----------------------------------------

  echo "Creating symlink..."

  ln -sfn "$binary_path" "$libexec_dir/$executable_name" || {
    die "Failed to create executable symlink."
  }

  # ----------------------------------------
  # 5. Create Mason wrapper
  # ----------------------------------------

  wrapper_script="$package_dir/$executable_name"

  echo "Creating wrapper:"
  echo "$wrapper_script"

  cat > "$wrapper_script" <<EOF
#!/data/data/com.termux/files/usr/bin/bash

exec "$libexec_dir/$executable_name" "\$@"
EOF

  chmod +x "$wrapper_script" || {
    die "Failed to make wrapper executable."
  }

  # ----------------------------------------
  # 6. Verify
  # ----------------------------------------

  if ! "$wrapper_script" --version >/dev/null 2>&1; then
    echo
    echo "Warning: executable was created, but --version failed."
    echo "This does not necessarily mean the executable is broken."
  fi

  # ----------------------------------------
  # Done
  # ----------------------------------------

  echo
  echo "========================================"
  echo " Setup completed successfully"
  echo "========================================"
  echo
  echo "Package : $package_name"
  echo "Binary  : $binary_path"
  echo "Mason   : $wrapper_script"
  echo
}

setup_package_for_mason "$@"
